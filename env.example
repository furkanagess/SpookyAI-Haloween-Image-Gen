# SpookyAI configuration. Nothing here is bundled into the app.
# Development convenience only: the app reads this file at run time if present,
# but release builds must use --dart-define (see SECURITY.md).

# Development: direct fal key (NEVER ship a build with this set)
FAL_AI_API_KEY=

# Release: proxy instead of a key (tool/fal_proxy)
FAL_PROXY_URL=
FAL_PROXY_TOKEN=

# RevenueCat public SDK keys (Project settings > API keys)
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
